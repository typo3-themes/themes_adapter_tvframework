# Settings of Build/Scripts/runTests.sh for this package
PACKAGE_NAME="typo3-themes/themes-adapter-tvframework"
TEST_NAMESPACE='KayStrobach\Themes\Adapter\TvFramework\Tests\'
# gridelements (required by themes) has no release for TYPO3 v14 yet
SUPPORTED_VERSIONS="12 13"
CORE_PACKAGES="core backend extbase fluid frontend install form"
DATABASE=sqlite

# themes and themes-gridelements: the clones next to this one, otherwise their branches on GitHub
EXTRA_REPOSITORIES=()
EXTRA_REQUIRE=('"typo3-themes/themes-gridelements": "*"')
EXTRA_DOCKER_VOLUMES=""
for dependency in "themes:typo3-themes/themes:typo3-12-13-14" "themes-gridelements:typo3-themes/themes-gridelements:typo3-12-13-14"; do
    folder="${dependency%%:*}"; rest="${dependency#*:}"; package="${rest%%:*}"; branch="${rest#*:}"
    path="$(cd "${EXTENSION_ROOT}/.." && pwd)/${folder}"
    if [ -f "${path}/composer.json" ]; then
        EXTRA_DOCKER_VOLUMES="${EXTRA_DOCKER_VOLUMES} -v ${path}:/dependencies/${folder}"
        EXTRA_REPOSITORIES+=("{\"type\": \"path\", \"url\": \"/dependencies/${folder}\", \"options\": {\"symlink\": true, \"versions\": {\"${package}\": \"99.0.0\"}}}")
    else
        EXTRA_REPOSITORIES+=("{\"type\": \"vcs\", \"url\": \"https://github.com/${package/\//\/}\"}")
        EXTRA_REQUIRE+=("\"${package}\": \"dev-${branch}\"")
    fi
done
